{
  "name" : "Appointment",
  "description" : "A scheduled or requested patient visit with a doctor.",
  "acl" : {
    "admin" : [ "create", "read", "update", "delete" ],
    "doctor" : [ "create", "read", "update", "delete" ],
    "patient" : [ "create", "read", "update" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "patientId",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "description" : "The patient attending this appointment."
  }, {
    "name" : "doctorId",
    "type" : "long",
    "required" : true,
    "indexed" : true,
    "description" : "The doctor conducting this appointment."
  }, {
    "name" : "appointmentDateTime",
    "type" : "timestamp",
    "required" : true,
    "indexed" : true,
    "description" : "The date and time of the appointment."
  }, {
    "name" : "status",
    "type" : "string",
    "length" : 50,
    "required" : true,
    "indexed" : true,
    "enumValues" : "pending,confirmed,cancelled,completed,rescheduled",
    "defaultValue" : "pending",
    "description" : "The current status of the appointment."
  }, {
    "name" : "reasonForVisit",
    "type" : "string",
    "length" : 255,
    "required" : true,
    "searchable" : true,
    "description" : "The patient's stated reason for the visit."
  }, {
    "name" : "notes",
    "type" : "text",
    "searchable" : true,
    "listHidden" : true,
    "description" : "Internal notes about the appointment, typically added by staff or doctor."
  }, {
    "name" : "type",
    "type" : "string",
    "length" : 50,
    "indexed" : true,
    "enumValues" : "consultation,follow_up,check_up,emergency",
    "defaultValue" : "consultation",
    "description" : "The type of appointment."
  }, {
    "name" : "durationMinutes",
    "type" : "integer",
    "minValue" : 15,
    "maxValue" : 240,
    "defaultValue" : 30,
    "description" : "The planned duration of the appointment in minutes."
  }, {
    "name" : "location",
    "type" : "string",
    "length" : 255,
    "description" : "The physical location where the appointment will take place."
  }, {
    "name" : "cancellationReason",
    "type" : "string",
    "length" : 255,
    "description" : "Reason provided if the appointment was cancelled."
  } ]
}