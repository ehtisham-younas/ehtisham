{
  "name" : "UserToTenant",
  "description" : "Link table for user-to-tenant membership. Records active flag, tenant-level role (admin/user), invitation acceptance, and developer flag. A user must have a UserToTenant row to access the tenant's data. ACL is admin-read only: membership mutations go through the dedicated /admin/** endpoints.",
  "acl" : {
    "admin" : [ "read" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "idOfUser",
    "type" : "biginteger",
    "defaultValue" : "-1",
    "indexed" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "tenantId",
    "type" : "biginteger",
    "defaultValue" : "-1",
    "indexed" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "active",
    "type" : "boolean",
    "defaultValue" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "role",
    "type" : "string",
    "length" : 50,
    "persistent" : true,
    "description" : "primary role of the user 'admin' or 'user'",
    "platform" : true
  }, {
    "name" : "superAdmin",
    "type" : "boolean",
    "persistent" : true,
    "defaultValue" : false,
    "platform" : true,
    "description" : "Per-tenant super-admin: a refinement of role=admin. Default false => admin==superAdmin until an AppPolicy activates the distinction."
  }, {
    "name" : "invitedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "invitationAcceptedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "invitationAccepted",
    "type" : "boolean",
    "defaultValue" : true,
    "persistent" : true
  }, {
    "name" : "developer",
    "type" : "boolean",
    "persistent" : true
  } ]
}