{
  "name" : "AppPolicy",
  "description" : "Per-app activation state for a seeded platform policy (identity model). One row per policy name; absence of a row means inactive (the default). Valid names are fixed by the platform's PolicyRegistry; this row carries only the per-app active flag and optional JSON params. ACL is admin-read only: writes go through the dedicated /admin/policies endpoints.",
  "acl" : {
    "admin" : [ "read" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "tenantId",
    "type" : "long",
    "defaultValue" : "-1",
    "indexed" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "name",
    "type" : "string",
    "indexed" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "active",
    "type" : "boolean",
    "defaultValue" : "false",
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "params",
    "type" : "string",
    "persistent" : true,
    "platform" : true
  } ]
}