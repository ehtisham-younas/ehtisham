{
  "name" : "OAuthProvider",
  "description" : "Per-tenant OAuth / OIDC provider configuration (Google, Azure AD, custom IdP). Stores client credentials, endpoint URIs, JWK set URI, and behavior flags like autoRegister and domainRestriction. Drives federated login.",
  "dataApi" : "open",
  "acl" : {
    "admin" : [ "read" ]
  },
  "attributes" : [ {
    "name" : "id",
    "type" : "biginteger",
    "persistent" : true,
    "primaryKey" : true,
    "systemAttr" : true,
    "autoSequence" : true
  }, {
    "name" : "createdAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "updatedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deleted",
    "type" : "boolean",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "deletedAt",
    "type" : "biginteger",
    "persistent" : true,
    "systemAttr" : true
  }, {
    "name" : "tenantId",
    "type" : "long",
    "defaultValue" : "-1",
    "indexed" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "provider",
    "type" : "string",
    "length" : 50,
    "indexed" : true,
    "persistent" : true,
    "description" : "Provider name: google, github, microsoft, or custom",
    "platform" : true
  }, {
    "name" : "clientId",
    "type" : "string",
    "length" : 255,
    "persistent" : true,
    "description" : "OAuth2 client ID from the provider",
    "platform" : true
  }, {
    "name" : "clientSecretEncrypted",
    "type" : "text",
    "persistent" : true,
    "description" : "AES-256-GCM encrypted client secret. Never stored in plaintext.",
    "platform" : true
  }, {
    "name" : "scopes",
    "type" : "string",
    "persistent" : true,
    "description" : "Space-separated scopes, e.g., email profile",
    "platform" : true
  }, {
    "name" : "authorizationUri",
    "type" : "string",
    "persistent" : true,
    "description" : "Provider authorization endpoint URL",
    "platform" : true
  }, {
    "name" : "tokenUri",
    "type" : "string",
    "persistent" : true,
    "description" : "Provider token endpoint URL",
    "platform" : true
  }, {
    "name" : "userInfoUri",
    "type" : "string",
    "persistent" : true,
    "description" : "Provider userinfo endpoint (for non-OIDC like GitHub)",
    "platform" : true
  }, {
    "name" : "jwkSetUri",
    "type" : "string",
    "persistent" : true,
    "description" : "Provider JWKS endpoint (for OIDC ID token validation)",
    "platform" : true
  }, {
    "name" : "issuerUri",
    "type" : "string",
    "persistent" : true,
    "description" : "OIDC issuer URI for auto-discovery",
    "platform" : true
  }, {
    "name" : "enabled",
    "type" : "boolean",
    "defaultValue" : true,
    "persistent" : true,
    "platform" : true
  }, {
    "name" : "autoRegister",
    "type" : "boolean",
    "defaultValue" : false,
    "persistent" : true,
    "description" : "Auto-create users on first OAuth login",
    "platform" : true
  }, {
    "name" : "domainRestriction",
    "type" : "string",
    "persistent" : true,
    "description" : "Optional email domain restriction, e.g., @company.com",
    "platform" : true
  }, {
    "name" : "frontendUrl",
    "type" : "string",
    "persistent" : true,
    "description" : "App frontend URL for OAuth redirect (e.g., https://myapp.example.com)",
    "platform" : true
  } ]
}